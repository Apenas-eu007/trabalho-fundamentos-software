body {
    background-color: #f0f8ff;
    color: #ff6347;
    font-family: Arial, sans-serif;
}
.container {
    max-width: 800px;
    margin: auto;
    padding: 20px;
}
h1, h2, h3 {
    color: #ff6347;
}
a {
    color: blue;
    text-decoration: none;
}
a:hover {
    color: green;
}
.image-container img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 10px 0;
}